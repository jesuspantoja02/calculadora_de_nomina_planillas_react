{
  "name": "nomina-api",
  "version": "2.0.0",
  "description": "API REST de planillas/nómina — Node.js + Express + TypeScript (arquitectura hexagonal por módulos)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/main.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.ts",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "typescript": "^6.0.0",
    "zod": "^4.0.0"
  }
}
