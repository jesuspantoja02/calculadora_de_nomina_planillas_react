# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
# Base de datos SQLite (se crea sola al iniciar)
DATABASE_FILE=data/nomina.db
# Peticiones máximas por IP cada 15 minutos
RATE_LIMIT_MAX=300
# Firma de tokens de sesión (mín. 16 caracteres; cambiar en producción)
AUTH_SECRET=dev-nomina-auth-secret-cambiar-en-prod
# Duración del token en horas
AUTH_TOKEN_TTL_HOURS=12
